# copy to .env: cp .env.example .env

# --- Kafka ---
KAFKA_VERSION=3.9.1
# same id on all 3 nodes (new one: kafka-storage.sh random-uuid)
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
TOPIC_NAME=taxi-trips-stream
TOPIC_PARTITIONS=6
# used when running scripts from the host; containers use kafka-1:9092,...
KAFKA_BOOTSTRAP_SERVERS=localhost:19092,localhost:29092,localhost:39092

# --- Producer ---
WATCH_DIR=data/daily
SENT_FILES=data/sent_files.json
# rows per second (10-50)
PRODUCER_RATE=20
PRODUCER_METRICS_PORT=8000

# --- ClickHouse ---
CLICKHOUSE_VERSION=25.8
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=admin
CLICKHOUSE_DB=taxi_stream

# --- Processor ---
CONSUMER_GROUP=taxi-processor
# a batch = this many trips or seconds
PROCESSOR_BATCH_SIZE=500
PROCESSOR_FLUSH_SECONDS=5
PROCESSOR_METRICS_PORT=8001

# --- Sliding window (by dropoff time) ---
WINDOW_MINUTES=10
WINDOW_SLIDE_MINUTES=5
# save windows + commit every N minutes
WINDOW_TRIGGER_MINUTES=5
# trips older than newest - N minutes are late
ALLOWED_LATENESS_MINUTES=2

LOG_LEVEL=INFO

# --- Grafana (user admin) ---
GRAFANA_PASSWORD=admin
